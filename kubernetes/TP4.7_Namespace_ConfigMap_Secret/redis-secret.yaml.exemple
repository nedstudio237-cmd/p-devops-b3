# Défi 3 : équivalent YAML de « kubectl create secret generic redis-secret --from-literal=… »
# NE PAS COMMITER la version remplie : stringData est en clair (et data n'est que du base64).
# Ce fichier .exemple ne contient qu'une valeur fictive.
apiVersion: v1
kind: Secret
metadata:
  name: redis-secret
  namespace: legeni-dev
  labels: {env: dev}
type: Opaque
stringData:
  REDIS_PASSWORD: "<a-remplacer-hors-git>"
